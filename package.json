{
  "name": "neostream-tv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "//browserslist": "Chromium 69 = Tizen 5.5, o mínimo declarado em tizen/config.xml. Serve ao eslint-plugin-compat; o build do Tizen passa o alvo explicitamente e o build web não usa o plugin-legacy.",
  "browserslist": [
    "chrome >= 69"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build",
    "build:tizen": "node scripts/build-tizen.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check:css": "node scripts/check-tizen-css.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "terser": "^5.51.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  }
}
